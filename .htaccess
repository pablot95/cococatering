# .htaccess para Coco Catering - Optimizacion SEO y Performance

# Habilitar compresion GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache del navegador
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>

# Forzar HTTPS (cuando tengas SSL)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redireccionar www a non-www (o viceversa)
# RewriteEngine On
# RewriteCond %{HTTP_HOST} ^www\.cococatering\.com\.ar [NC]
# RewriteRule ^(.*)$ https://cococatering.com.ar/$1 [L,R=301]

# URLs limpias (sin extension .html)
RewriteEngine On

# 1. Redirigir cualquier peticion *.html a URL sin extension (301 permanente)
#    Excepto index.html para no romper la raiz
RewriteCond %{THE_REQUEST} \s/+(?:web/)?(.*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,NE,L]

# 2. Servir internamente el .html cuando se accede a la URL limpia
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Prevenir hotlinking de imagenes
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?cococatering.com.ar [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [NC,F,L]

# Deshabilitar listado de directorios
Options -Indexes

# Pagina de error 404 personalizada
ErrorDocument 404 /index.html

# Seguridad - Prevenir acceso a archivos sensibles
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
